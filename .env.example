# Clés API (ne jamais committer le vrai .env)
VITE_GEMINI_API_KEY=
VITE_ANTHROPIC_API_KEY=

# Synchronisation cloud optionnelle (plan gratuit Supabase).
# Laisser vide pour rester 100 % local.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend / tests (jamais de VITE_* : ces valeurs ne doivent pas atteindre le navigateur)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Management API (configuration email hébergée)
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# SMTP Payzik (configuration locale / CLI uniquement)
PAYZIK_SMTP_HOST=
PAYZIK_SMTP_PORT=587
PAYZIK_SMTP_USER=
PAYZIK_SMTP_PASS=

# Identité d'expéditeur
# Mode test gratuit : onboarding@resend.dev (uniquement vers l'email du compte Resend).
# Production : remplacer par une adresse sur un domaine vérifié, ex. no-reply@payzik.ma.
PAYZIK_SENDER_NAME=Payzik
PAYZIK_FROM_EMAIL=onboarding@resend.dev
