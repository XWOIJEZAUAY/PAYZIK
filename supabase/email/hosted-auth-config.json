{
  "mailer_autoconfirm": false,
  "mailer_subjects_confirmation": "Payzik — confirmez votre adresse email",
  "mailer_templates_confirmation_content": "<!doctype html>\n<html lang=\"fr\">\n<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Payzik — confirmation</title></head>\n<body style=\"margin:0;padding:24px;background:#FFF8EA;color:#3A2A1F;font-family:Arial,Helvetica,sans-serif;\">\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:560px;margin:0 auto;background:#FFFFFF;border-radius:16px;padding:28px;\">\n    <tr><td style=\"font-size:22px;font-weight:700;color:#FF7A1A;\">PAYZIK</td></tr>\n    <tr><td style=\"padding-top:20px;font-size:18px;font-weight:700;\">Confirmez votre adresse email</td></tr>\n    <tr><td style=\"padding-top:12px;font-size:14px;line-height:22px;\">\n      Bonjour, vous avez créé un compte Payzik avec l'adresse <strong>{{ .Email }}</strong>.<br>\n      Cliquez sur le bouton ci-dessous pour finaliser la vérification.\n    </td></tr>\n    <tr><td style=\"padding-top:22px;\">\n      <a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#FF7A1A;color:#FFFFFF;text-decoration:none;padding:12px 20px;border-radius:10px;font-weight:700;\">Confirmer mon email</a>\n    </td></tr>\n    <tr><td style=\"padding-top:22px;font-size:12px;line-height:20px;color:#6B594A;\">\n      Si le bouton ne fonctionne pas, copiez ce lien dans votre navigateur :<br>\n      <span style=\"word-break:break-all;\">{{ .ConfirmationURL }}</span><br><br>\n      Si vous n'êtes pas à l'origine de cette inscription, ignorez cet email.\n    </td></tr>\n  </table>\n</body>\n</html>\n",
  "mailer_subjects_recovery": "Payzik — réinitialisez votre mot de passe",
  "mailer_templates_recovery_content": "<!doctype html>\n<html lang=\"fr\">\n<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Payzik — mot de passe</title></head>\n<body style=\"margin:0;padding:24px;background:#FFF8EA;color:#3A2A1F;font-family:Arial,Helvetica,sans-serif;\">\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:560px;margin:0 auto;background:#FFFFFF;border-radius:16px;padding:28px;\">\n    <tr><td style=\"font-size:22px;font-weight:700;color:#FF7A1A;\">PAYZIK</td></tr>\n    <tr><td style=\"padding-top:20px;font-size:18px;font-weight:700;\">Réinitialisez votre mot de passe</td></tr>\n    <tr><td style=\"padding-top:12px;font-size:14px;line-height:22px;\">\n      Une demande de réinitialisation a été effectuée pour <strong>{{ .Email }}</strong>.<br>\n      Utilisez le lien ci-dessous pour choisir un nouveau mot de passe. Ce lien est à usage unique.\n    </td></tr>\n    <tr><td style=\"padding-top:22px;\">\n      <a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#FF7A1A;color:#FFFFFF;text-decoration:none;padding:12px 20px;border-radius:10px;font-weight:700;\">Réinitialiser le mot de passe</a>\n    </td></tr>\n    <tr><td style=\"padding-top:22px;font-size:12px;line-height:20px;color:#6B594A;\">\n      Lien de secours : <span style=\"word-break:break-all;\">{{ .ConfirmationURL }}</span><br><br>\n      Si vous n'êtes pas à l'origine de cette demande, ignorez cet email ; votre mot de passe restera inchangé.\n    </td></tr>\n  </table>\n</body>\n</html>\n",
  "mailer_subjects_email_change": "Payzik — confirmez votre nouvelle adresse email",
  "mailer_templates_email_change_content": "<!doctype html>\n<html lang=\"fr\">\n<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Payzik — changement d'email</title></head>\n<body style=\"margin:0;padding:24px;background:#FFF8EA;color:#3A2A1F;font-family:Arial,Helvetica,sans-serif;\">\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:560px;margin:0 auto;background:#FFFFFF;border-radius:16px;padding:28px;\">\n    <tr><td style=\"font-size:22px;font-weight:700;color:#FF7A1A;\">PAYZIK</td></tr>\n    <tr><td style=\"padding-top:20px;font-size:18px;font-weight:700;\">Confirmez votre nouvelle adresse</td></tr>\n    <tr><td style=\"padding-top:12px;font-size:14px;line-height:22px;\">\n      Vous avez demandé à utiliser <strong>{{ .NewEmail }}</strong> comme nouvelle adresse Payzik.<br>\n      Confirmez cette adresse pour finaliser le changement.\n    </td></tr>\n    <tr><td style=\"padding-top:22px;\">\n      <a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#FF7A1A;color:#FFFFFF;text-decoration:none;padding:12px 20px;border-radius:10px;font-weight:700;\">Confirmer la nouvelle adresse</a>\n    </td></tr>\n    <tr><td style=\"padding-top:22px;font-size:12px;line-height:20px;color:#6B594A;\">\n      Lien de secours : <span style=\"word-break:break-all;\">{{ .ConfirmationURL }}</span><br><br>\n      Si vous n'êtes pas à l'origine de cette demande, ignorez cet email.\n    </td></tr>\n  </table>\n</body>\n</html>\n",
  "mailer_subjects_magic_link": "Payzik — votre lien de connexion",
  "mailer_templates_magic_link_content": "<!doctype html>\n<html lang=\"fr\">\n<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Payzik — connexion</title></head>\n<body style=\"margin:0;padding:24px;background:#FFF8EA;color:#3A2A1F;font-family:Arial,Helvetica,sans-serif;\">\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:560px;margin:0 auto;background:#FFFFFF;border-radius:16px;padding:28px;\">\n    <tr><td style=\"font-size:22px;font-weight:700;color:#FF7A1A;\">PAYZIK</td></tr>\n    <tr><td style=\"padding-top:20px;font-size:18px;font-weight:700;\">Votre lien de connexion</td></tr>\n    <tr><td style=\"padding-top:12px;font-size:14px;line-height:22px;\">\n      Cliquez sur le bouton pour vous connecter à Payzik avec <strong>{{ .Email }}</strong>.<br>\n      Ce lien expire rapidement et ne peut être utilisé qu'une seule fois.\n    </td></tr>\n    <tr><td style=\"padding-top:22px;\">\n      <a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#FF7A1A;color:#FFFFFF;text-decoration:none;padding:12px 20px;border-radius:10px;font-weight:700;\">Se connecter</a>\n    </td></tr>\n    <tr><td style=\"padding-top:22px;font-size:12px;line-height:20px;color:#6B594A;\">\n      Lien de secours : <span style=\"word-break:break-all;\">{{ .ConfirmationURL }}</span><br><br>\n      Si vous n'avez pas demandé ce lien, ignorez cet email.\n    </td></tr>\n  </table>\n</body>\n</html>\n",
  "mailer_subjects_reauthentication": "Payzik — code de vérification : {{ .Token }}",
  "mailer_templates_reauthentication_content": "<!doctype html>\n<html lang=\"fr\">\n<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Payzik — vérification</title></head>\n<body style=\"margin:0;padding:24px;background:#FFF8EA;color:#3A2A1F;font-family:Arial,Helvetica,sans-serif;\">\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:560px;margin:0 auto;background:#FFFFFF;border-radius:16px;padding:28px;\">\n    <tr><td style=\"font-size:22px;font-weight:700;color:#FF7A1A;\">PAYZIK</td></tr>\n    <tr><td style=\"padding-top:20px;font-size:18px;font-weight:700;\">Votre code de vérification</td></tr>\n    <tr><td style=\"padding-top:12px;font-size:14px;line-height:22px;\">\n      Saisissez le code ci-dessous dans Payzik pour confirmer votre identité. Il expire rapidement.\n    </td></tr>\n    <tr><td style=\"padding-top:18px;font-size:26px;font-weight:700;letter-spacing:4px;color:#D95F00;\">{{ .Token }}</td></tr>\n    <tr><td style=\"padding-top:18px;font-size:12px;line-height:20px;color:#6B594A;\">\n      Ne partagez jamais ce code. Si vous n'êtes pas à l'origine de cette demande, ignorez cet email.\n    </td></tr>\n  </table>\n</body>\n</html>\n",
  "mailer_subjects_invite": "Payzik — invitation à rejoindre votre espace",
  "mailer_templates_invite_content": "<!doctype html>\n<html lang=\"fr\">\n<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Payzik — invitation</title></head>\n<body style=\"margin:0;padding:24px;background:#FFF8EA;color:#3A2A1F;font-family:Arial,Helvetica,sans-serif;\">\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:560px;margin:0 auto;background:#FFFFFF;border-radius:16px;padding:28px;\">\n    <tr><td style=\"font-size:22px;font-weight:700;color:#FF7A1A;\">PAYZIK</td></tr>\n    <tr><td style=\"padding-top:20px;font-size:18px;font-weight:700;\">Vous êtes invité sur Payzik</td></tr>\n    <tr><td style=\"padding-top:12px;font-size:14px;line-height:22px;\">\n      Acceptez l'invitation pour activer votre accès à l'espace Payzik associé à <strong>{{ .Email }}</strong>.\n    </td></tr>\n    <tr><td style=\"padding-top:22px;\">\n      <a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#FF7A1A;color:#FFFFFF;text-decoration:none;padding:12px 20px;border-radius:10px;font-weight:700;\">Accepter l'invitation</a>\n    </td></tr>\n    <tr><td style=\"padding-top:22px;font-size:12px;line-height:20px;color:#6B594A;\">\n      Lien de secours : <span style=\"word-break:break-all;\">{{ .ConfirmationURL }}</span>\n    </td></tr>\n  </table>\n</body>\n</html>\n",
  "mailer_notifications_password_changed_enabled": true,
  "mailer_subjects_password_changed_notification": "Payzik — votre mot de passe a été modifié",
  "mailer_templates_password_changed_notification_content": "<!doctype html>\n<html lang=\"fr\">\n<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Payzik — sécurité</title></head>\n<body style=\"margin:0;padding:24px;background:#FFF8EA;color:#3A2A1F;font-family:Arial,Helvetica,sans-serif;\">\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:560px;margin:0 auto;background:#FFFFFF;border-radius:16px;padding:28px;\">\n    <tr><td style=\"font-size:22px;font-weight:700;color:#FF7A1A;\">PAYZIK</td></tr>\n    <tr><td style=\"padding-top:20px;font-size:18px;font-weight:700;\">Votre mot de passe a été modifié</td></tr>\n    <tr><td style=\"padding-top:12px;font-size:14px;line-height:22px;\">\n      Le mot de passe du compte <strong>{{ .Email }}</strong> vient d'être changé.<br>\n      Si vous n'êtes pas à l'origine de cette action, réinitialisez immédiatement votre mot de passe et contactez le support.\n    </td></tr>\n  </table>\n</body>\n</html>\n",
  "mailer_notifications_email_changed_enabled": true,
  "mailer_subjects_email_changed_notification": "Payzik — votre adresse email a été modifiée",
  "mailer_templates_email_changed_notification_content": "<!doctype html>\n<html lang=\"fr\">\n<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Payzik — sécurité</title></head>\n<body style=\"margin:0;padding:24px;background:#FFF8EA;color:#3A2A1F;font-family:Arial,Helvetica,sans-serif;\">\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:560px;margin:0 auto;background:#FFFFFF;border-radius:16px;padding:28px;\">\n    <tr><td style=\"font-size:22px;font-weight:700;color:#FF7A1A;\">PAYZIK</td></tr>\n    <tr><td style=\"padding-top:20px;font-size:18px;font-weight:700;\">Votre adresse email a été modifiée</td></tr>\n    <tr><td style=\"padding-top:12px;font-size:14px;line-height:22px;\">\n      L'adresse de votre compte Payzik est passée de <strong>{{ .OldEmail }}</strong> à <strong>{{ .Email }}</strong>.<br>\n      Si vous n'êtes pas à l'origine de cette action, contactez immédiatement le support.\n    </td></tr>\n  </table>\n</body>\n</html>\n",
  "mailer_notifications_phone_changed_enabled": true,
  "mailer_subjects_phone_changed_notification": "Payzik — votre numéro de téléphone a été modifié",
  "mailer_templates_phone_changed_notification_content": "<!doctype html>\n<html lang=\"fr\">\n<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Payzik — sécurité</title></head>\n<body style=\"margin:0;padding:24px;background:#FFF8EA;color:#3A2A1F;font-family:Arial,Helvetica,sans-serif;\">\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:560px;margin:0 auto;background:#FFFFFF;border-radius:16px;padding:28px;\">\n    <tr><td style=\"font-size:22px;font-weight:700;color:#FF7A1A;\">PAYZIK</td></tr>\n    <tr><td style=\"padding-top:20px;font-size:18px;font-weight:700;\">Votre numéro a été modifié</td></tr>\n    <tr><td style=\"padding-top:12px;font-size:14px;line-height:22px;\">\n      Le numéro associé à votre compte est passé de <strong>{{ .OldPhone }}</strong> à <strong>{{ .Phone }}</strong>.<br>\n      Si vous n'êtes pas à l'origine de cette action, contactez immédiatement le support.\n    </td></tr>\n  </table>\n</body>\n</html>\n",
  "mailer_notifications_mfa_factor_enrolled_enabled": true,
  "mailer_subjects_mfa_factor_enrolled_notification": "Payzik — une méthode de vérification a été ajoutée",
  "mailer_templates_mfa_factor_enrolled_notification_content": "<!doctype html>\n<html lang=\"fr\">\n<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Payzik — sécurité</title></head>\n<body style=\"margin:0;padding:24px;background:#FFF8EA;color:#3A2A1F;font-family:Arial,Helvetica,sans-serif;\">\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:560px;margin:0 auto;background:#FFFFFF;border-radius:16px;padding:28px;\">\n    <tr><td style=\"font-size:22px;font-weight:700;color:#FF7A1A;\">PAYZIK</td></tr>\n    <tr><td style=\"padding-top:20px;font-size:18px;font-weight:700;\">Méthode de vérification ajoutée</td></tr>\n    <tr><td style=\"padding-top:12px;font-size:14px;line-height:22px;\">\n      Une méthode de vérification <strong>{{ .FactorType }}</strong> a été ajoutée au compte <strong>{{ .Email }}</strong>.<br>\n      Si vous n'êtes pas à l'origine de cette action, contactez immédiatement le support.\n    </td></tr>\n  </table>\n</body>\n</html>\n",
  "mailer_notifications_mfa_factor_unenrolled_enabled": true,
  "mailer_subjects_mfa_factor_unenrolled_notification": "Payzik — une méthode de vérification a été retirée",
  "mailer_templates_mfa_factor_unenrolled_notification_content": "<!doctype html>\n<html lang=\"fr\">\n<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Payzik — sécurité</title></head>\n<body style=\"margin:0;padding:24px;background:#FFF8EA;color:#3A2A1F;font-family:Arial,Helvetica,sans-serif;\">\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:560px;margin:0 auto;background:#FFFFFF;border-radius:16px;padding:28px;\">\n    <tr><td style=\"font-size:22px;font-weight:700;color:#FF7A1A;\">PAYZIK</td></tr>\n    <tr><td style=\"padding-top:20px;font-size:18px;font-weight:700;\">Méthode de vérification retirée</td></tr>\n    <tr><td style=\"padding-top:12px;font-size:14px;line-height:22px;\">\n      La méthode de vérification <strong>{{ .FactorType }}</strong> a été retirée du compte <strong>{{ .Email }}</strong>.<br>\n      Si vous n'êtes pas à l'origine de cette action, contactez immédiatement le support.\n    </td></tr>\n  </table>\n</body>\n</html>\n",
  "mailer_notifications_identity_linked_enabled": true,
  "mailer_subjects_identity_linked_notification": "Payzik — une méthode de connexion a été liée",
  "mailer_templates_identity_linked_notification_content": "<!doctype html>\n<html lang=\"fr\">\n<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Payzik — sécurité</title></head>\n<body style=\"margin:0;padding:24px;background:#FFF8EA;color:#3A2A1F;font-family:Arial,Helvetica,sans-serif;\">\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:560px;margin:0 auto;background:#FFFFFF;border-radius:16px;padding:28px;\">\n    <tr><td style=\"font-size:22px;font-weight:700;color:#FF7A1A;\">PAYZIK</td></tr>\n    <tr><td style=\"padding-top:20px;font-size:18px;font-weight:700;\">Connexion {{ .Provider }} liée</td></tr>\n    <tr><td style=\"padding-top:12px;font-size:14px;line-height:22px;\">\n      Le fournisseur <strong>{{ .Provider }}</strong> a été lié au compte <strong>{{ .Email }}</strong>.<br>\n      Si vous n'êtes pas à l'origine de cette action, contactez immédiatement le support.\n    </td></tr>\n  </table>\n</body>\n</html>\n",
  "mailer_notifications_identity_unlinked_enabled": true,
  "mailer_subjects_identity_unlinked_notification": "Payzik — une méthode de connexion a été retirée",
  "mailer_templates_identity_unlinked_notification_content": "<!doctype html>\n<html lang=\"fr\">\n<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Payzik — sécurité</title></head>\n<body style=\"margin:0;padding:24px;background:#FFF8EA;color:#3A2A1F;font-family:Arial,Helvetica,sans-serif;\">\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:560px;margin:0 auto;background:#FFFFFF;border-radius:16px;padding:28px;\">\n    <tr><td style=\"font-size:22px;font-weight:700;color:#FF7A1A;\">PAYZIK</td></tr>\n    <tr><td style=\"padding-top:20px;font-size:18px;font-weight:700;\">Connexion {{ .Provider }} retirée</td></tr>\n    <tr><td style=\"padding-top:12px;font-size:14px;line-height:22px;\">\n      Le fournisseur <strong>{{ .Provider }}</strong> a été retiré du compte <strong>{{ .Email }}</strong>.<br>\n      Si vous n'êtes pas à l'origine de cette action, contactez immédiatement le support.\n    </td></tr>\n  </table>\n</body>\n</html>\n"
}
